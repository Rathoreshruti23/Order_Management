# Spring Boot REST API base URL
VITE_API_BASE_URL=http://localhost:8080/api

# Google OAuth Web client ID (public value; never put a client SECRET here)
VITE_GOOGLE_CLIENT_ID=

# (dev default is true when unset)
# true  = products, AI stylist and newsletter use the built-in demo data (no backend needed)
# false = everything calls the Spring Boot API
# Sign in / sign up / orders ALWAYS call the backend; they are never mocked.
VITE_USE_MOCK_DATA=true
